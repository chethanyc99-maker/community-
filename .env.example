# ==============================================================================
# Prerana Assistive Learning Platform - Environment Configuration Example
# Copy to `.env` for local runs or set these keys in Render Dashboard -> Environment
# ==============================================================================

FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret-key

# OPTION 1 (Recommended for Render Cloud MySQL: Aiven / TiDB Cloud / Railway):
# Paste your single Managed MySQL connection URI below:
MYSQL_URL=mysql://user:password@your-cloud-mysql-host:3306/computer_based_learning

# OPTION 2 (Local MySQL / Individual Host Variables):
# Leave MYSQL_URL unset if using individual fields below.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=computer_based_learning

# Optional: Set if your Managed MySQL provider requires strict CA verification
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_VERIFY=true
